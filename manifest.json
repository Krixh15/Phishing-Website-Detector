{
  "manifest_version": 3,
  "name": "AI Phishing Website Detector",
  "version": "1.0.0",
  "description": "Client-side machine learning extension that analyzes website URLs and predicts whether they are Legitimate, Suspicious, or Phishing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Phishing Detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.css",
        "warning.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
